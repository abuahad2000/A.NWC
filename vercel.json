{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "infographic_report.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "XLSX/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/infographic",
      "dest": "/infographic_report.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}